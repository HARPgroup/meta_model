#!/bin/bash
# loads the args, raster & geo specific config AND CHANGE TO TEMPDIR
response_config=`find_config response.config`
if [ "$response_config" = "" ]; then
  response_config="$META_MODEL_ROOT/models/drought/response/response.config"
fi
. $response_config
# BEGIN - actually loading local data

echo "POSTing analysis results of no rain projection for ${GAGE}"

cd $tempdir
echo "Calling: Rscript $META_MODEL_ROOT/scripts/usgs/norain_post.R $ANALYSISFILE"
Rscript $META_MODEL_ROOT/scripts/usgs/norain_post.R $ANALYSISFILE
