#!/bin/bash
if [ -z "$scenario" ]; then 
   # try to get from cmd args
   scenario=$1
   gage=$2
   tempdir=$3
fi
export scenario coverage tempdir
if [ -z "$gage" ]; then 
  echo "Error: missing Arguments."
  echo "Script must be called as: 'script_name scenario gage [temp dir]'"
  echo "Scenario may supply date and other config info for the gage desired."
  yr=`date +'%Y'`
  echo "Ex: $yr norain_roanoke 02071000 "
  exit
fi
# create temp dir
if [ ! -d "$tempdir" ]; then
  mkdir $tempdir
fi

cd $tempdir

#echo "Drought response config called with scenario $scenario and gage $gage"

START_DATE=`cbp get_config $scenario script START_DATE`
if [ "$START_DATE" == "" ]; then
  START_DATE=`date -d "yesterday" +"%Y-%m-%d"`
fi

USGS_DATA_DIR=`cbp get_config $scenario script USGS_DIR`

ADJUST_START_DATE=`cbp get_config $scenario script ADJUST_START_DATE`

NORAINFILE="${scenario}_norain90.csv"
FCFILE="${scenario}_${gage}_forecast_${START_DATE}.csv"
ANALYSISFILE="${scenario}_analysis.csv"
FULLANALYSISFILE="$USGS_DATA_DIR/norain/$all_{scenario}_analysis.csv"

GAGE=$gage
SCENARIO_NAME=$scenario

export START_DATE USGS_DATA_DIR ADJUST_START_DATE NORAINFILE FCFILE ANALYSISFILE FULLANALYSISFILE GAGE SCENARIO_NAME